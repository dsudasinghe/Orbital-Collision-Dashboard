# Copy to .env and fill in. Never commit .env.
#
# Supabase: Project → Connect → "Session pooler" connection string (port 5432).
# The session pooler works over IPv4; the direct connection is IPv6-only on free projects.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Space-Track login (the email and password you sign in with at space-track.org).
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# CelesTrak asks clients to identify themselves; include a contact.
CELESTRAK_USER_AGENT=orbital-collision-dashboard/0.1 (contact: you@example.com)
